# Build/install outputs of the superproject (submodule build dirs are
# covered by ignore = dirty in .gitmodules).
/tools/
/sby-venv/
# Generated per-machine by `make openxc7-prjxray` (printf > bin/fasm2frames):
# it bakes in absolute repo/venv paths, so it must not be tracked.
/bin/fasm2frames

# User-local machine-specific scripts (kept untracked on purpose)
/repoint_usr_local_bin.zsh
/cleanup_old_builds.zsh

# Machine-local environment additions sourced by env-linux.sh (untracked
# on purpose, like the *.zsh scripts above)
/site-env.sh
/openxc7-venv/
